{
  "expo": {
    "name": "LifePilot",
    "slug": "lifepilot",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "lifepilot",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#0D0D0D"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lifepilot.app"
    },
    "android": {
      "package": "com.lifepilot.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "lifepilot"
      }
    }
  }
}