{
  "name": "lifepilot",
  "version": "1.0.0",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "db:generate": "yarn workspace @lifepilot/db prisma generate",
    "db:push": "yarn workspace @lifepilot/db prisma db push",
    "db:migrate": "yarn workspace @lifepilot/db prisma migrate"
  },
  "devDependencies": {
    "@types/node": "^20.19.40",
    "turbo": "^2.0.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=20"
  }
}