{
  "name": "lifepilot",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "db:generate": "pnpm --filter @lifepilot/db generate",
    "db:push": "pnpm --filter @lifepilot/db db push",
    "db:migrate": "pnpm --filter @lifepilot/db migrate"
  },
  "devDependencies": {
    "@types/node": "^20.19.40",
    "@types/react-native": "^0.73.0",
    "turbo": "^2.0.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=20"
  }
}